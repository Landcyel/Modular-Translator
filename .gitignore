# ── Root .gitignore — ModularTranslator ──
# Internal rules for app_light/ live in app_light/.gitignore (docs/notes/API keys etc.)

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Archives/backups
*.rar
*.zip
*.bak

# Dependencies/models/runtime (GB-scale, not committed; distributed separately)
# Note: app_light/dependencies and app_light/characters are junctions pointing to
# the root level; directory patterns without a leading slash cover both the root
# and app_light levels, preventing git from following the junctions and pulling
# 15GB+ into the index
dependencies/
characters/

# Virtual environments
.venv/
venv/
env/

# Physical copies of the dual versions (app_workflow / app_lite) — point-in-time
# snapshots refreshed by exporting from git branches; not committed (authoritative
# source = git branch)
app_workflow/
app_lite/

# Build artifacts and intermediate files (/build/ anchored at root; keep
# app_light/build/ packaging scripts)
/build/
dist/
build_assets/
*.spec

# Artifacts, logs and temporary files
/app.log
output/
temp/
logs/
test_data/

# Tool working directory
.zcode/

# IDE / system
.idea/
.vscode/
Thumbs.db
.DS_Store
