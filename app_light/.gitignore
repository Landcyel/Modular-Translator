dist/
build_assets/
*.spec

# 生成物与临时文件
output/
temp/

# 本地配置（含真实 API 密钥，不提交；模板为 default.example.json）
configs/models/API/default.json

# 仅跟踪 configs/ core/ ui/ app/ APP.py（及 pytest.ini），以下为本地文档/测试数据/临时内容
